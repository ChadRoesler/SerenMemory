# ═══════════════════════════════════════════════════════════════════════
#  seren-memory.yaml - config for SerenMemory
# ═══════════════════════════════════════════════════════════════════════
#
#  Copy to seren-memory.yaml, edit, and run:
#     python -m seren_memory --config seren-memory.yaml
#
#  Or just run with no config at all - the defaults below are baked in, so
#  `python -m seren_memory` works zero-config for a local dev spin.
#
#  Env vars override file values (handy for Docker/systemd):
#     SEREN_MEMORY_PORT, SEREN_MEMORY_HOST, SEREN_MEMORY_BEARER_TOKEN,
#     SEREN_MEMORY_PERSIST_DIR, SEREN_MEMORY_MODEL_URL,
#     SEREN_MEMORY_MODEL_NAME, SEREN_MEMORY_CONSOLIDATOR_ENABLED
#
# ═══════════════════════════════════════════════════════════════════════

server:
  host: 127.0.0.1       # local-only. 0.0.0.0 = the LAN - set a token below first
  # allow_open_lan: false
  #   A host beyond loopback with no token REFUSES TO START and prints the
  #   three ways out. Set this true (or <PREFIX>_ALLOW_OPEN_LAN=1) to run open on
  #   purpose - a trusted LAN, a lab - and it will say so on every boot.
  port: 7420
  # Leave empty for no auth (trusted LAN / dev). Set a token to require
  #   Authorization: Bearer <token>
  # on every endpoint except / and /health.
  bearer_token: ""

storage:
  # Where chroma persists. ~ is expanded. Created if missing.
  persist_dir: ~/.seren-memory/chroma
  # Collection names - rarely need changing.
  short_collection: seren_short
  near_collection: seren_near
  long_collection: seren_long
  brief_collection: seren_briefs
  # Embedding model. Leave null for chroma's default (all-MiniLM-L6-v2 as
  # ONNX, ~80MB, CPU-friendly, no torch, downloaded on first use). Naming a
  # model needs `pip install seren-memory[st]` (sentence-transformers, and
  # torch with it) - the installer's --st flag.
  embedding_model: null

lifetimes:
  # ShortTerm entries older than this become eligible to age out during
  # consolidation (unless promoted or pinned). 8 days = a week plus drift.
  # 691200 = 8 * 24 * 3600.
  short_term_seconds: 691200
  # NearTerm intents with no explicit expiry get REVIEWED (not auto-deleted)
  # after this long unfulfilled. 30 days.
  near_term_review_seconds: 2592000

consolidator:
  # Consolidation - the sleep, the drafts, the model - is SerenHippocampus's
  # (install it beside this). The in-process consolidator that used to live
  # here was retired on 25 Sept 2026; an old config's enabled / mode /
  # model_url / interval keys still load and are ignored.

  # Before /tidy deletes an aged-out short-term entry, it copies it to a
  # 'pruned' collection for this many days as insurance. 0 = no safety net.
  pruned_safety_days: 14

# -- Corporate / intercepting-proxy support (opt-in) ------------------------
# If you're on a corporate network that does TLS interception (Zscaler,
# Netskope, etc.), the proxy's root CA is in your OS trust store but not in
# Python's bundled certs, so outbound HTTPS fails with CERTIFICATE_VERIFY_FAILED.
# Turn this on to route TLS through the OS trust store instead.
#
# Requires the corp extra:  pip install seren-memory[corp]
# Or just run the installer with --corp (it sets this and installs the extra).
# tls:
#   trust_system_store: true

# ── Update checking ───────────────────────────────────────────────────
#
# Asks the package index whether a newer seren-memory exists, and reports it on
# GET /. Purely informational - the service never upgrades itself. Applying
# an update is `pip install -U seren-memory` plus a restart, which belongs to your
# service supervisor (systemd, NSSM), not to this process.
#
# Enabled here by default, but it only DOES anything if the checking code is
# installed:  pip install 'seren-memory[updates]'
# Without that you get status="unavailable" plus a reason - never a quiet
# "you're up to date" from something that never actually looked.
#
# The result is cached for check_interval_hours and the lookup never happens
# in the request path, so the route stays fast.
updates:
  enabled: true
  check_interval_hours: 6      # cached; never checked per-request
  allow_prerelease: false      # true would offer you e.g. 2.0.0rc1
  # index_url: "https://pypi.org/pypi/{distribution}/json"   # private index?
